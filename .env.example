# App configuration
NODE_ENV=development
# El backend escucha en 4000; Vite usa 3000 en desarrollo.
PORT=4000
DB_PATH=./data/app.db

# MySQL (Hostinger). También se aceptan DB_HOST/DB_USER/DB_NAME/DB_PASSWORD.
MYSQL_HOST="your_hostinger_mysql_host"
MYSQL_PORT=3306
MYSQL_DATABASE="your_database_name"
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_CONNECTION_LIMIT=10

# Superadmin. En producción usa una contraseña fuerte y no la subas al repo.
SUPERADMIN_USERNAME="RafaAdmin"
SUPERADMIN_PASSWORD=""

# Secreto HMAC para las sesiones. Si se deja vacío se genera data/.session_secret.
SESSION_SECRET=""
# Límite absoluto del token. La conexión activa se comprueba además cada segundo.
SESSION_TTL_HOURS=168
# Desconexión: 10 segundos. Las pruebas aisladas pueden ampliar este valor.
SESSION_DISCONNECT_MS=10000

# App metadata. APP_URL es la base de los enlaces de recuperación de
# contraseña que envía el superadmin (debe apuntar al frontend).
SUPERADMIN_EMAIL="admin@example.com"
APP_URL="http://localhost:3000"

# Correos de la plataforma, incluidos los reportes diarios al cerrar sesión.
# Sin SMTP, el cierre de sesión funciona, pero el reporte no se envía.
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Vigencia del enlace de recuperación de contraseña (minutos). Por defecto 60.
PASSWORD_RESET_TTL_MINUTES=60

# Payment gateways (Stripe & PayPal) credentials for subscriptions & checkout
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Google OAuth Client ID for GIS popup authentication (Gmail send & Calendar events)
VITE_GOOGLE_CLIENT_ID=""

# Geoapify Geocoding API key. Se usa exclusivamente en el backend para
# confirmar que la dirección de registro existe y pertenece a la localidad
# seleccionada. La clave no debe llevar el prefijo VITE_ ni llegar al navegador.
GEOAPIFY_API_KEY=""

# Supabase: archivos y relaciones de medios. La clave secreta solo se usa en
# el backend; nunca la expongas con el prefijo VITE_.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_BUCKET="app-images"
# Solo si el navegador necesita usar Supabase directamente con RLS.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
