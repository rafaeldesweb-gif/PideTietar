{
  "name": "pidetietar",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:responsive": "node scripts/responsive-check.mjs",
    "server": "node server.js",
    "start": "node server.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:api": "node --test scripts/crud-check.test.mjs scripts/profile-check.test.mjs scripts/media-replacement.test.mjs",
    "test:forms": "node --test --test-concurrency=1 scripts/forms-ui-check.test.mjs scripts/profile-ui-check.test.mjs scripts/media-upload-ui-check.test.mjs",
    "test:preproduction": "npm run lint && npm test && npm run test:api && npm run test:forms && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.15",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
